# ─────────────────────────────────────────────────────────────────────────────
# CommitScope — Environment Variable Template
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=commitscope
POSTGRES_USER=commitscope
# Change this before any deployment. Use a strong random password.
POSTGRES_PASSWORD=commitscope_dev_change_me

# ── Backend ───────────────────────────────────────────────────────────────────
# The async SQLAlchemy connection string used by FastAPI.
# When running via Docker Compose, the host is "postgres" (service name).
# When running locally outside Docker, use "localhost".
DATABASE_URL=postgresql+asyncpg://commitscope:commitscope_dev_change_me@localhost:5432/commitscope

# Enable SQLAlchemy query echo and FastAPI debug mode. Set false in production.
DEBUG=false

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of absolute filesystem paths that CommitScope is allowed
# to read as git repositories. Requests for paths outside these roots are
# rejected. Leave empty to disallow all local repositories (useful for testing).
#
# Example:
#   ALLOWED_REPO_ROOTS=/home/user/projects,/workspace/repos
ALLOWED_REPO_ROOTS=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins the browser frontend is served from.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# The URL that the browser uses to reach the backend API.
# When running Docker Compose locally, this is http://localhost:8000.
VITE_API_URL=http://localhost:8000
